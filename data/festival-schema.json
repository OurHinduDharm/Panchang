{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ourhindudharm.github.io/Panchang/data/festival-schema.json",
  "title": "OurHinduDharm Festival Data",
  "description": "Draft structure for migrating the existing Blogger festivalData. This schema does not decide or certify festival dates.",
  "type": "object",
  "required": [
    "schemaVersion",
    "festivals"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "dataStatus": {
      "type": "string"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "festivals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "date"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "alternateNames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "articleUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "date": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "fixed",
                  "tithi",
                  "solar",
                  "astronomical",
                  "event-duration",
                  "manual"
                ]
              },
              "start": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "end": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "rule": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tithi": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "paksha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "month": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "calculationNotes": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "startTithi": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Start tithi for a recurring tithi-driven observance or event-duration range."
              },
              "endTithi": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Inclusive end tithi for a recurring tithi-driven event-duration range."
              },
              "durationDays": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "description": "Expected number of tithi-days, inclusive; informational and must not replace Panchang calculation."
              },
              "renderMode": {
                "type": [
                  "string",
                  "null"
                ],
                "enum": [
                  "panchang-tithi-range",
                  "fixed-date",
                  "manual",
                  null
                ],
                "description": "Renderer instruction; panchang-tithi-range must use calculated local Panchang data, not static Gregorian dates."
              },
              "calendarRule": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Human-readable recurring-calendar rule. Does not certify the calculation."
              }
            },
            "additionalProperties": true
          },
          "duration": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "days": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "description": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "additionalProperties": true
          },
          "pujaMuhurat": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "start": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "end": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "notes": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": true
            }
          },
          "tradition": {
            "type": [
              "string",
              "null"
            ]
          },
          "statusText": {
            "type": [
              "string",
              "null"
            ]
          },
          "verificationStatus": {
            "enum": [
              "unreviewed",
              "needs-review",
              "verified"
            ]
          },
          "sourceText": {
            "type": [
              "object",
              "null"
            ],
            "description": "Optional verbatim legacy fields retained during migration."
          },
          "reviewNotes": {
            "type": [
              "array",
              "null"
            ],
            "description": "Owner-confirmed editorial or display-intent notes. These do not certify the date calculation.",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "navratriSadhana": {
      "type": "object",
      "required": [
        "title",
        "description",
        "activePeriodIds",
        "days"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "activePeriodIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "days": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": [
              "day",
              "tithi",
              "name"
            ],
            "properties": {
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              "tithi": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "pitriPakshaArticles": {
      "type": "object",
      "required": [
        "title",
        "description",
        "activePeriodIds",
        "articles"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "activePeriodIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "articles": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": [
              "title"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
